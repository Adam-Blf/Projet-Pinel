# Sorties de compilation
bin/
obj/
publish/
*.user
*.suo
.vs/

# Livrables volumineux, regeneres par la compilation
*.exe
*.pdb

# Donnees et secrets, jamais versionnes
*.env
.env*
*.pfx
*.cer
*.key
*.pem
*secret*
*.token

# Fichiers PMSI : aucun fichier de donnees patient ne doit entrer ici
*.rps
*.raa
*.RPS
*.RAA
donnees/
data/
echantillons/

# Sorties de documentation regenerables
docs/*.pdf

# Systeme
Thumbs.db
desktop.ini
~$*

# Descriptifs officiels de l ATIH : 41 Mo de documents publics, regeneres
# par tools/telecharger_formats_atih.py. Le moyen de les retrouver est
# versionne, les documents eux-memes n ont pas leur place dans l historique.
reference/atih/
