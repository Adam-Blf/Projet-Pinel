<Window x:Class="Pinel.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Pinel" Height="900" Width="1440"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="#0B1220"
        Icon="pack://application:,,,/app.ico">
    <Grid>
        <wv2:WebView2 x:Name="WebView" />
        <!-- Hidden WebView2 used by the HTML→PDF renderer. Never displayed. -->
        <wv2:WebView2 x:Name="PdfWebView" Visibility="Collapsed"
                      Width="794" Height="1123" />
    </Grid>
</Window>
